<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/wallet_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Multi-Coin Wallet"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/testnet_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TESTNET"
            android:textSize="10sp"
            android:textColor="@android:color/holo_red_dark"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/wallet_header"
            app:layout_constraintBottom_toBottomOf="@id/wallet_header"
            android:layout_marginStart="8dp" />
        
        <!-- Wallet Name / Switcher -->
        <TextView
            android:id="@+id/wallet_name_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Wallet"
            android:textSize="14sp"
            android:textColor="@android:color/holo_blue_light"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Coin Selector Tabs -->
        <LinearLayout
            android:id="@+id/coin_selector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wallet_header">

            <Button
                android:id="@+id/coin_coco"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="CoCo"
                android:textSize="11sp"
                android:padding="2dp" />
            <Button
                android:id="@+id/coin_btc"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="BTC"
                android:textSize="11sp"
                android:padding="2dp" />
            <Button
                android:id="@+id/coin_eth"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="ETH"
                android:textSize="11sp"
                android:padding="2dp" />
            <Button
                android:id="@+id/coin_sol"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="SOL"
                android:textSize="11sp"
                android:padding="2dp" />
            <Button
                android:id="@+id/coin_usdc"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="USDC"
                android:textSize="11sp"
                android:padding="2dp" />
            <Button
                android:id="@+id/coin_usdt"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="USDT"
                android:textSize="11sp"
                android:padding="2dp" />
        </LinearLayout>

        <!-- Selected Coin Address -->
        <TextView
            android:id="@+id/wallet_address_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Address"
            android:textColor="#888"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/coin_selector" />

        <TextView
            android:id="@+id/wallet_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="—"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wallet_address_label" />

        <!-- Balance -->
        <TextView
            android:id="@+id/balance_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Balance"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wallet_address" />

        <TextView
            android:id="@+id/balance_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="—"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/balance_header" />

        <!-- USD Value -->
        <TextView
            android:id="@+id/balance_usd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#888"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/balance_amount" />

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/action_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/balance_usd">

            <Button
                android:id="@+id/btn_refresh"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Refresh" />

            <Button
                android:id="@+id/btn_send"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="Send" />

            <Button
                android:id="@+id/btn_receive"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Receive" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_backup_wallet"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Backup Seed Phrase"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/action_row" />

        <!-- Create / Import buttons (shown when no wallet) -->
        <Button
            android:id="@+id/btn_create_wallet"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Create New Wallet"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_backup_wallet" />

        <Button
            android:id="@+id/btn_import_wallet"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="Import from Seed Phrase"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_create_wallet" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
