<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a0a">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗳 Voting"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#f5c918" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active elections and results"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/identity_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:background="#111111">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪪 Identity"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#f5c918" />

            <TextView
                android:id="@+id/identity_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checking identity…"
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_identity_refresh"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Check"
                    android:textSize="13sp"
                    android:background="#1a1a1a"
                    android:textColor="#f5c918" />

                <Button
                    android:id="@+id/btn_identity_claim"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Claim"
                    android:textSize="13sp"
                    android:background="#1a1a1a"
                    android:textColor="#f5c918"
                    android:enabled="false" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/voting_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:background="#111111"
            android:visibility="gone">

            <TextView
                android:id="@+id/my_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#888888"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/my_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#f5c918"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_refresh_elections"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="↻ Refresh"
            android:textSize="13sp"
            android:layout_marginBottom="12dp"
            android:background="#1a1a1a"
            android:textColor="#f5c918" />

        <TextView
            android:id="@+id/elections_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading elections..."
            android:textSize="14sp"
            android:textColor="#888888"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/elections_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
