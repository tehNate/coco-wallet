<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🪪 CoCo Account"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#f5c918"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tv_account_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Not signed in — account is optional"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your 12 words are the wallet. Signing in only adds an encrypted backup so you can restore on another phone/browser."
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btn_account_signin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Sign In / Restore Wallet"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <Button
            android:id="@+id/btn_account_backup"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Back Up This Wallet"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <Button
            android:id="@+id/btn_account_register"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:text="Create a CoCo Account"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btn_account_signout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Sign Out"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btn_backup_seed"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Show Seed Phrase"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <Switch
            android:id="@+id/switch_testnet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Testnet Mode"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/switch_beta_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Use beta server (cocoio.cc)"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_diagnostics"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Wallet Diagnostics"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <Button
            android:id="@+id/btn_clear_wallet"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Clear Wallet"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="@android:color/holo_red_dark" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CoCo Wallet · keys stay on this device unless you explicitly back them up."
            android:textSize="11sp"
            android:textColor="#555555"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
